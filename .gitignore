# 환경변수 · 비밀키 (솔라피 API 키, Supabase 키 등)
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# 의존성
node_modules/
.pnp
.pnp.js

# 빌드 결과물
.next/
out/
dist/
build/
*.tsbuildinfo
# next-env.d.ts는 무시하지 않고 커밋한다. tsconfig.json의 include가 이 파일을
# 이름으로 명시하므로, 무시하면 새로 클론한 곳에서 next 명령을 먼저 돌리기 전까지
# `npm run typecheck`가 TS6053으로 실패한다.

# 셀러 개인정보가 담길 수 있는 파일 (네이버폼 엑셀 다운로드 등)
*.xlsx
*.xls
*.csv
셀러명단*
확정셀러*

